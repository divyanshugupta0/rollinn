{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "schools": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "code",
        "ownerId",
        "status"
      ],
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "publicSchools": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "status",
        "subscriptionEndDate"
      ]
    },
    "publicCourseCatalog": {
      ".read": true,
      "$schoolId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && (root.child('users').child(auth.uid).child('schoolId').val() === $schoolId || auth.uid === $schoolId)"
      }
    },
    "schoolAdmins": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "email",
        "username",
        "schoolId"
      ]
    },
    "schoolCodeReservations": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$code": {
        ".validate": "newData.val() == null || (newData.hasChildren(['createdAt', 'ownerId']) && newData.child('createdAt').isString() && newData.child('ownerId').isString())"
      }
    },
    "cloudflare_r2": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "cloudflare_endpoint": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "owners": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        ".write": "auth != null && auth.uid === $ownerUid"
      }
    },
    "users": {
      ".read": true,
      ".write": "auth != null",
      "$uid": {
        ".read": true,
        ".write": "auth != null",
        "faceDescriptor": {
          ".write": true
        }
      },
      ".indexOn": [
        "email",
        "classRoll",
        "univRoll",
        "section",
        "role",
        "schoolId"
      ]
    },
    "deviceLogins": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "deviceLocks": {
      ".read": true,
      ".write": "auth != null"
    },
    "deviceFingerprintLocks": {
      ".read": true,
      ".write": "auth != null"
    },
    "userLocks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendance": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "user_attendance": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendance_by_location": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "locations": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$locationId": {
        "coordinates": {
          ".read": "auth != null",
          ".write": "auth != null || (newData.child('token').isString() && root.child('locationRequests').child(newData.child('token').val()).exists())"
        }
      },
      ".indexOn": [
        "section",
        "expiresAt",
        "active"
      ]
    },
    "locationRequests": {
      ".read": true,
      ".write": true
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "recipients"
      ]
    },
    "passwordResetRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "email",
        "status",
        "timestamp"
      ]
    },
    "profileRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "status",
        "userId"
      ]
    },
    "profile_update_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "ownerId",
        "schoolId",
        "status",
        "timestamp"
      ]
    },
    "subscriptionExpiryOverlayCounts": {
      "$schoolId": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)",
          ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('schoolId').val() === $schoolId && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'teacher')"
        }
      }
    },
    "subscriptionResubscribeRequests": {
      "$schoolId": {
        "$requesterUid": {
          ".read": "auth != null && (auth.uid === $requesterUid || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)",
          ".write": "auth != null && ((auth.uid === $requesterUid && root.child('users').child(auth.uid).child('schoolId').val() === $schoolId && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'teacher')) || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)"
        }
      }
    },
    "modificationRequests": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "status",
        "teacherId"
      ]
    },
    "schoolSettings": {
      "$schoolId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() === $schoolId || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() === $schoolId || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['schoolId']) && newData.child('schoolId').val() === $schoolId",
        ".indexOn": [
          "securityPinSetAt"
        ]
      }
    },
    "accessibility_settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "faceRegistrationTokens": {
      ".read": true,
      ".write": true
    }
  }
}
