{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      ".read": true,
      ".write": "auth != null",
      "$uid": {
        "faceDescriptor": {
          ".write": true
        }
      },
      ".indexOn": [
        "email",
        "classRoll",
        "univRoll",
        "section",
        "role"
      ]
    },
    "deviceLogins": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "deviceLocks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendance": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "user_attendance": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendance_by_location": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "locations": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$locationId": {
        "coordinates": {
          ".read": "auth != null",
          ".write": "auth != null || (newData.child('token').isString() && root.child('locationRequests').child(newData.child('token').val()).exists())"
        }
      },
      ".indexOn": [
        "section",
        "expiresAt",
        "active"
      ]
    },
    "locationRequests": {
      ".read": true,
      ".write": true
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "recipients"
      ]
    },
    "passwordResetRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "email",
        "status",
        "timestamp"
      ]
    },
    "profileRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "status",
        "userId"
      ]
    },
    "modificationRequests": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "status",
        "teacherId"
      ]
    },
    "adminSettings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "accessibility_settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "faceRegistrationTokens": {
      ".read": true,
      ".write": true
    }
  }
}
