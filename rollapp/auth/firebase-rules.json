{
  "rules": {
    "schools": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "code",
        "ownerId",
        "status",
        "type",
        "institutionType"
      ],
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "publicSchools": {
      ".read": true,
      ".indexOn": [
        "code",
        "status",
        "subscriptionEndDate"
      ],
      "$schoolId": {
        ".write": "auth != null && (root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner' || (!data.exists() && newData.child('code').isString() && root.child('schoolCodeReservations').child(newData.child('code').val()).child('ownerId').val() === auth.uid))",
        "registrationLive": {
          ".read": true,
          ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('schoolId').val() === $schoolId) || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "publicCourseCatalog": {
      ".read": true,
      "$schoolId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)"
      }
    },
    "schoolAdmins": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "email",
        "username",
        "schoolId"
      ]
    },
    "schoolCodeReservations": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$code": {
        ".validate": "newData.val() == null || (newData.hasChildren(['createdAt', 'ownerId']) && newData.child('createdAt').isString() && newData.child('ownerId').isString())"
      }
    },
    "owners": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        ".write": "auth != null && auth.uid === $ownerUid",
        "pricingPlans": {
          ".read": "auth != null && (auth.uid === $ownerUid || (root.child('users').child(auth.uid).child('schoolId').exists() && root.child('schools').child(root.child('users').child(auth.uid).child('schoolId').val()).child('ownerId').val() === $ownerUid))"
        }
      }
    },
    "users": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "email",
        "classRoll",
        "univRoll",
        "section",
        "role",
        "schoolId",
        "dob",
        "dateOfBirth",
        "classId",
        "appDownloadUsed",
        "status",
        "academicBatch",
        "batch"
      ],
      "$uid": {
        ".read": true,
        ".write": "auth != null",
        "faceDescriptor": {
          ".write": true
        }
      }
    },
    "schoolUsers": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "email",
          "role",
          "section",
          "classRoll",
          "univRoll",
          "dob",
          "dateOfBirth",
          "classId",
          "className",
          "enrolledClassId",
          "academicBatch",
          "batch"
        ]
      }
    },
    "schoolClasses": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "teacherId",
          "teacherEmail",
          "status"
        ]
      }
    },
    "schoolSections": {
      "$schoolId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() === $schoolId || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)",
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('schoolId').val() === $schoolId) || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)",
        ".indexOn": [
          "courseId",
          "courseName",
          "year",
          "name"
        ]
      }
    },
    "classes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "schoolLocations": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "teacherId",
          "teacherEmail",
          "status",
          "section"
        ]
      }
    },
    "schoolCourses": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "courses": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "schoolTimetables": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "schoolTimetablesVersion": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "schoolTimetableSettings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "timetables": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "classTeacherAssignments": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "teacherId",
          "section"
        ]
      }
    },
    "classTeacherAssignmentsByClass": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "subjectTeacherAssignments": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "schoolHomework": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "section",
          "classId",
          "className",
          "teacherId",
          "createdAt",
          "dueDate",
          "defaultersReviewed"
        ]
      }
    },
    "schoolClassHomework": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "studentHomeworkDefaulters": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "markedAt",
          "homeworkId",
          "dueDate"
        ]
      }
    },
    "studentHomeworkStatus": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "schoolTests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "section",
          "classId",
          "className",
          "teacherId",
          "testDate",
          "createdAt",
          "status"
        ]
      }
    },
    "schoolTestScores": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "schoolStudentScores": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$studentId": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".indexOn": [
            "testDate",
            "subject",
            "isAbsent"
          ]
        }
      }
    },
    "classTeacherProfileRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "status",
          "timestamp",
          "createdAt",
          "studentId",
          "section",
          "schoolId"
        ]
      }
    },
    "classTeacherLeaveRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": [
          "status",
          "timestamp",
          "createdAt",
          "studentId",
          "section",
          "schoolId"
        ]
      }
    },
    "teacher_leave_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$schoolId": {
        ".indexOn": [
          "teacherId",
          "status",
          "createdAt"
        ]
      }
    },
    "leave_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$studentId": {
        ".indexOn": [
          "status",
          "timestamp",
          "createdAt"
        ]
      }
    },
    "attendance": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "user_attendance": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "student_attendance": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendance_by_location": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$classOrLocationId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$date": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "attendance_locations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendance_drafts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "attendance_audit": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "locations": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "section",
        "expiresAt",
        "active",
        "schoolId"
      ],
      "$locationId": {
        "coordinates": {
          ".read": "auth != null",
          ".write": "auth != null || (newData.child('token').isString() && root.child('locationRequests').child(newData.child('token').val()).exists())"
        }
      }
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "schoolId"
      ]
    },
    "locationRequests": {
      ".read": true,
      ".write": true
    },
    "displayed_classes": {
      ".read": true,
      ".write": "auth != null"
    },
    "deviceLogins": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "deviceLocks": {
      ".read": true,
      ".write": "auth != null"
    },
    "deviceFingerprintLocks": {
      ".read": true,
      ".write": "auth != null"
    },
    "userLocks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "userSessions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "device_unlock_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "status",
        "userId",
        "schoolId"
      ]
    },
    "blockedUsers": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('schoolId').val() === root.child('users').child($uid).child('schoolId').val() && (root.child('users').child($uid).child('role').val() === 'student' || root.child('users').child($uid).child('role').val() === 'teacher')"
      }
    },
    "faceRegistrationTokens": {
      ".read": true,
      ".write": true
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "recipients",
        "schoolId"
      ]
    },
    "passwordResetRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "email",
        "status",
        "timestamp"
      ]
    },
    "passwordResetLimits": {
      ".read": false,
      ".write": false
    },
    "profileRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "status",
        "userId"
      ]
    },
    "profile_update_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": [
        "ownerId",
        "schoolId",
        "status",
        "timestamp"
      ]
    },
    "modificationRequests": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "status",
        "teacherId"
      ]
    },
    "erpLicenseKeys": {
      ".read": false,
      ".write": false,
      ".indexOn": ["expiresAt"]
    },
    "erpLicenseCodes": {
      ".read": false,
      ".write": false,
      ".indexOn": ["schoolId"]
    },
    "erpLicenseDevices": {
      ".read": false,
      ".write": false
    },
    "schoolDeletionJobs": {
      ".read": false,
      ".write": false
    },
    "subscriptionExpiryOverlayCounts": {
      ".read": "auth != null && (root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      ".write": "auth != null && (root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      "$schoolId": {
        ".read": "auth != null && (root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".write": "auth != null && (root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
          ".write": "auth != null && ((auth.uid === $uid && root.child('users').child(auth.uid).child('schoolId').val() === $schoolId && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'teacher')) || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')"
        }
      }
    },
    "subscriptionResubscribeRequests": {
      ".read": "auth != null && (root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      ".write": "auth != null && (root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
      "$schoolId": {
        ".read": "auth != null && (root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        ".write": "auth != null && (root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
        "$requesterUid": {
          ".read": "auth != null && (auth.uid === $requesterUid || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')",
          ".write": "auth != null && ((auth.uid === $requesterUid && root.child('users').child(auth.uid).child('schoolId').val() === $schoolId && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'teacher')) || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid || root.child('owners').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'owner')"
        }
      }
    },
    "schoolSettings": {
      "$schoolId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() === $schoolId || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() === $schoolId || root.child('schools').child($schoolId).child('ownerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['schoolId']) && newData.child('schoolId').val() === $schoolId",
        ".indexOn": [
          "securityPinSetAt"
        ]
      }
    },
    "accessibility_settings": {
      ".read": true,
      ".write": "auth != null",
      "attendanceCapturing": {
        ".validate": "newData.isBoolean()"
      },
      "desktopAttendanceBlocked": {
        ".validate": "newData.isBoolean()"
      },
      "privacyMode": {
        ".validate": "newData.isBoolean()"
      },
      "largeText": {
        ".validate": "newData.isBoolean()"
      },
      "highContrast": {
        ".validate": "newData.isBoolean()"
      },
      "audioNotifications": {
        ".validate": "newData.isBoolean()"
      },
      "mobileOptimization": {
        ".validate": "newData.isBoolean()"
      },
      "lastUpdated": {
        ".validate": "newData.isNumber()"
      },
      "updatedBy": {
        ".validate": "newData.isString()"
      }
    },
    "cloudflare_r2": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "cloudflare_endpoint": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "mobileCoordinates": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "teachers": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$teacherId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$adminId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "parentDetails": {
      ".read": "auth != null && root.child('owners').child(auth.uid).exists()",
      ".write": "auth != null",
      ".indexOn": ["submittedAt", "portal", "schoolId", "uid"],
      "$entryId": {
        ".read": "auth != null && root.child('owners').child(auth.uid).exists()",
        ".write": "auth != null"
      }
    },

    "user_attendance": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "attendance_by_location": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$locationId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "locations": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["schoolId", "name", "createdAt"],
      "$locationId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "blockedUsers": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["schoolId", "blockedDate", "role"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "accessibility_settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
