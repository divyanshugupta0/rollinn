        "id": "sec-1",
        "title": "Section A: Mechanics & Waves",
        "questions": [
          {
            "id": "q1",
            "text": "Which law of motion states that for every action, there is an equal and opposite reaction?",
            "type": "multiple_choice",
            "options": [
              "Newton First Law",
              "Newton Second Law",
              "Newton Third Law",
              "Law of Universal Gravitation"
            ],
            "marks": 2,
            "negativeMarks": 0.5,
            "explanation": "Newton Third Law states that all forces between two objects exist in equal magnitude and opposite directions."
          },
          {
            "id": "q2",
            "text": "What type of wave is a sound wave in air?",
            "type": "multiple_choice",
            "options": [
              "Transverse Wave",
              "Longitudinal Wave",
              "Electromagnetic Wave",
              "Standing Surface Wave"
            ],
            "marks": 2,
            "negativeMarks": 0.5,
            "explanation": "Sound waves in air are longitudinal waves consisting of compressions and rarefactions."
          },
          {
            "id": "q3",
            "text": "What is the speed of light in vacuum approximately?",
            "type": "multiple_choice",
            "options": [
              "3 x 10^8 m/s",
              "3 x 10^6 m/s",
              "3 x 10^5 km/h",
              "1.5 x 10^8 m/s"
            ],
            "marks": 2,
            "negativeMarks": 0.5,
            "explanation": "The speed of light in vacuum is approximately 299,792,458 m/s, or 3 x 10^8 m/s."
          }
        ]
      },
      {
        "id": "sec-2",
        "title": "Section B: Electricity & Magnetism",
        "questions": [
          {
            "id": "q4",
            "text": "What device converts mechanical energy into electrical energy using electromagnetic induction?",
            "type": "multiple_choice",
            "options": [
              "Electric Motor",
              "Electric Generator (Dynamo)",
              "Transformer",
              "Capacitor"
            ],
            "marks": 2,
            "negativeMarks": 0.5,
            "explanation": "An electric generator converts mechanical work into electric energy based on Faraday law of induction."
          },
          {
            "id": "q5",
            "text": "What happens to the total equivalent resistance when resistors are connected in parallel?",
            "type": "multiple_choice",
            "options": [
              "Increases",
              "Decreases",
              "Remains unchanged",
              "Becomes infinite"
            ],
            "marks": 2,
            "negativeMarks": 0.5,
            "explanation": "In parallel combination, total resistance 1/Req = 1/R1 + 1/R2, which is always less than the smallest individual resistor."
          }
        ]
      }
