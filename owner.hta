    // Add this function to your existing script
function showAlert(message, type) {
    const alertElement = document.createElement('div');
    alertElement.className = `alert alert-${type} alert-dismissible fade show`;
    alertElement.innerHTML = `<strong>${message}</strong>`;
    document.body.appendChild(alertElement);

    // Remove alert after 3 seconds
    setTimeout(() => {
        alertElement.remove();
    }, 3000);
}

    
    // Add this function to your existing script
    function loadSchoolsTable() {
        const schoolsTable = document.getElementById('schoolsTable');
        if (!schoolsTable) return;
        
        schoolsTable.innerHTML = '';
        
        schools.forEach(school => {
            const row = schoolsTable.insertRow();
            row.innerHTML = `
                <td>${school.name}</td>
                <td>${school.code}</td>
                <td>${school.type}</td>
                <td>${school.establishedYear}</td>
                <td>${school.status}</td>
                <td>
                    <button class="btn btn-sm btn-primary" onclick="editSchool(${school.id})">Edit</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteSchool(${school.id})">Delete</button>
                </td>
            `;
        });
    }
    
    // Add this function to your existing script
    function editSchool(id) {
        const school = schools.find(s => s.id === id);
        
        if (school) {
            document.getElementById('schoolName').value = school.name;
            document.getElementById('schoolCode').value = school.code;
            document.getElementById('schoolType').value = school.type;
            document.getElementById('establishedYear').value = school.establishedYear;
            document.getElementById('schoolAddress').value = school.address.complete;
            document.getElementById('city').value = school.address.city;
            document.getElementById('state').value = school.address.state;
            document.getElementById('zipCode').value = school.address.zipCode;
            document.getElementById('principalName').value = school.contacts.principal.name;
            document.getElementById('principalEmail').value = school.contacts.principal.email;
            document.getElementById('adminName').value = school.contacts.admin.name;
            document.getElementById('adminEmail').value = school.contacts.admin.email;
            document.getElementById('schoolPhone').value = school.contacts.phone;
            document.getElementById('alternatePhone').value = school.contacts.alternatePhone;
            document.getElementById('studentCapacity').value = school.details.capacity;
            document.getElementById('currentStudents').value = school.details.currentStudents;
            document.getElementById('teacherCount').value = school.details.teacherCount;
            document.getElementById('accreditation').value = school.details.accreditation;
            document.getElementById('website').value = school.details.website;
            
            // Update the modal content
            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }
    }
    
    // Add this function to your existing script
    function updateSchool(id) {
        const school = schools.find(s => s.id === id);
        
        if (school) {
            school.name = document.getElementById('schoolName').value;
            school.code = document.getElementById('schoolCode').value;
            school.type = document.getElementById('schoolType').value;
            school.establishedYear = document.getElementById('establishedYear').value;
            school.address.complete = document.getElementById('schoolAddress').value;
            school.address.city = document.getElementById('city').value;
            school.address.state = document.getElementById('state').value;
            school.address.zipCode = document.getElementById('zipCode').value;
            school.contacts.principal.name = document.getElementById('principalName').value;
            school.contacts.principal.email = document.getElementById('principalEmail').value;
            school.contacts.admin.name = document.getElementById('adminName').value;
            school.contacts.admin.email = document.getElementById('adminEmail').value;
            school.contacts.phone = document.getElementById('schoolPhone').value;
            school.contacts.alternatePhone = document.getElementById('alternatePhone').value;
            school.details.capacity = parseInt(document.getElementById('studentCapacity').value);
            school.details.currentStudents = parseInt(document.getElementById('currentStudents').value);
            school.details.teacherCount = parseInt(document.getElementById('teacherCount').value);
            school.details.accreditation = document.getElementById('accreditation').value;
            school.details.website = document.getElementById('website').value;
            
            // Update Firebase
            database.ref('schools/' + id).update(school);
            
            // Update the modal content
            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }
    }
    // Make sure this runs on page load
document.addEventListener('DOMContentLoaded', () => {
    // Explicitly make dashboard visible
    const dashboardSection = document.getElementById('dashboard');
    if (dashboardSection) {
        dashboardSection.style.display = 'block';
    }
    
    // Set up navigation click handlers
    const navLinks = document.querySelectorAll('.nav-link');
    navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = link.getAttribute('href').substring(1);
            switchSection(targetId);
            
            // Initialize charts if analytics section is selected
            if (targetId === 'analytics') {
                initializeAnalyticsCharts();
            }
        });
    });
    
    // Initialize the recent activities list
    initRecentActivities();
});

// Initialize analytics charts
