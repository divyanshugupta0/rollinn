    // Load Firebase configuration from owner's database
    function loadFirebaseConfig() {
        if (!currentUser) return;
        
        ownerAuth.database().ref('owners/' + currentUser.uid + '/schoolsFirebaseConfig').once('value')
            .then((snapshot) => {
                if (snapshot.exists()) {
                    const config = snapshot.val();
                    
                    // Fill in the form fields
                    document.getElementById('firebaseApiKey').value = config.apiKey;
                    document.getElementById('firebaseAuthDomain').value = config.authDomain;
                    document.getElementById('firebaseDatabaseURL').value = config.databaseURL;
                    document.getElementById('firebaseProjectId').value = config.projectId;
                    
                    // Auto-connect if all fields are filled
                    initializeFirebase();
                }
            })
            .catch(error => {
                console.error("Error loading Firebase configuration:", error);
            });
    }
    
    // Load schools from Firebase
    function loadSchoolsFromFirebase() {
        if (!database) return;
        
        database.ref('schools').on('value', (snapshot) => {
            const data = snapshot.val();
            if (data) {
                schools = Object.keys(data).map(key => ({
                    id: key,
                    ...data[key]
                }));
                loadSchoolsTable();
                updateDashboardStats();
            }
        });
    }
    
    // Enhanced school registration with Firebase
    function handleSchoolRegistration(e) {
        e.preventDefault();
        
        if (!isFirebaseConnected) {
            showAlert('Please connect to Firebase first', 'danger');
            return;
        }
        
        // Get admin credentials
        const adminUsername = document.getElementById('adminUsername').value;
        const adminPassword = document.getElementById('adminPassword').value;
        const adminEmail = document.getElementById('adminEmail').value;
        
        // Get subscription plan
        const subscriptionPlan = document.querySelector('input[name="subscriptionPlan"]:checked').value;
        const subscriptionDuration = subscriptionPlan === 'spark' ? 1 : 2; // months
        const subscriptionEndDate = new Date();
        subscriptionEndDate.setMonth(subscriptionEndDate.getMonth() + subscriptionDuration);
        
        // Get all form data
        const schoolData = {
            name: document.getElementById('schoolName').value,
            code: document.getElementById('schoolCode').value,
            type: document.getElementById('schoolType').value,
            establishedYear: document.getElementById('establishedYear').value,
            address: {
                complete: document.getElementById('schoolAddress').value,
                city: document.getElementById('city').value,
                state: document.getElementById('state').value,
                zipCode: document.getElementById('zipCode').value
            },
            contacts: {
                principal: {
                    name: document.getElementById('principalName').value,
                    email: document.getElementById('principalEmail').value
                },
                admin: {
                    name: document.getElementById('adminName').value,
                    email: adminEmail,
                    username: adminUsername
                },
                phone: document.getElementById('schoolPhone').value,
                alternatePhone: document.getElementById('alternatePhone').value
            },
            details: {
                capacity: parseInt(document.getElementById('studentCapacity').value),
                currentStudents: parseInt(document.getElementById('currentStudents').value) || 0,
                teacherCount: parseInt(document.getElementById('teacherCount').value) || 0,
                accreditation: document.getElementById('accreditation').value,
                website: document.getElementById('website').value
            },
            facilities: {
                library: document.getElementById('hasLibrary').checked,
                computerLab: document.getElementById('hasLab').checked,
                sports: document.getElementById('hasSports').checked,
                transportation: document.getElementById('hasTransport').checked
            },
            subscription: {
                plan: subscriptionPlan,
                startDate: new Date().toISOString(),
                endDate: subscriptionEndDate.toISOString(),
                status: 'active'
            },
            status: 'Active',
            registrationDate: new Date().toISOString(),
            lastUpdated: new Date().toISOString(),
            ownerId: currentUser.uid // Link to owner
        };
        
        // Check if school code already exists
        database.ref('schools').orderByChild('code').equalTo(schoolData.code).once('value')
            .then((snapshot) => {
                if (snapshot.exists()) {
                    showAlert('School code already exists. Please use a unique code.', 'danger');
                    return Promise.reject('duplicate_code');
                }
                
                // Save to Firebase schools database
                const newSchoolRef = database.ref('schools').push();
                const schoolId = newSchoolRef.key;
                
                // Save admin credentials to school's Firebase (not for authentication)
                database.ref(`schools/${schoolId}/adminCredentials`).set({
                    username: adminUsername,
                    password: adminPassword, // In a real app, this should be hashed
                    email: adminEmail
                });
                
                // Save school data without admin credentials
                database.ref(`schools/${schoolId}`).set(schoolData);
                
                // Save admin info (without password) and school data to owner's database
                const ownerSchoolData = {
                    ...schoolData,
                    schoolId: schoolId,
                    adminInfo: {
                        username: adminUsername,
                        email: adminEmail
                    }
                };
                
                // Save in owner's database
                if (currentUser) {
                    ownerAuth.database().ref('owners/' + currentUser.uid + '/schools/' + schoolId).set(ownerSchoolData);
                }
                
                return Promise.resolve();
            })
            .then(() => {
                showAlert('School registered successfully!', 'success');
                document.getElementById('schoolRegistrationForm').reset();
                
                // Add to recent activities
                addRecentActivity(`New school registered: ${schoolData.name}`);
            })
            .catch((error) => {
                if (error === 'duplicate_code') return; // Already handled
                
                console.error('Error registering school:', error);
                showAlert('Error registering school: ' + error.message, 'danger');
            });
    }
    
    // Enhanced school deletion with Firebase
    function deleteSchool(id) {
        if (!isFirebaseConnected) {
            showAlert('Firebase not connected', 'danger');
            return;
        }
        
        if (confirm('Are you sure you want to delete this school? This action cannot be undone.')) {
            database.ref('schools/' + id).remove()
                .then(() => {
                    showAlert('School deleted successfully!', 'success');
                    addRecentActivity('School deleted from system');
                })
                .catch((error) => {
                    console.error('Delete error:', error);
                    showAlert('Error deleting school: ' + error.message, 'danger');
                });
        }
    }
    
    // Add recent activity
    function addRecentActivity(activity) {
        // Add to local array
        recentActivities.unshift(activity);
        if (recentActivities.length > 10) {
            recentActivities.pop();
        }
        
        // Update UI
        initRecentActivities();
        
        // Save to owner's database
        if (currentUser) {
            const activityData = {
                message: activity,
                timestamp: Date.now()
            };
            
            ownerAuth.database().ref('owners/' + currentUser.uid + '/recentActivities').push(activityData)
                .catch(error => {
                    console.error('Error saving activity:', error);
                });
                
            // Limit to last 50 activities in database
            ownerAuth.database().ref('owners/' + currentUser.uid + '/recentActivities')
                .orderByChild('timestamp')
                .limitToLast(50)
                .once('value', snapshot => {
                    if (snapshot.exists()) {
                        ownerAuth.database().ref('owners/' + currentUser.uid + '/recentActivities').set(snapshot.val());
                    }
                });
        }
    }
    
