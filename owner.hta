// School registration with admin credentials and subscription plan
function addSchool() {
    // Get school data from the form
    const schoolData = {
        name: document.getElementById('modalSchoolName').value,
        type: document.getElementById('modalSchoolType').value,
        location: document.getElementById('modalSchoolLocation').value,
        contact: document.getElementById('modalSchoolContact').value
    };
    
    // Store school data in session storage for later use
    sessionStorage.setItem('pendingSchoolData', JSON.stringify(schoolData));
    
    // Hide the current modal
    const addSchoolModal = bootstrap.Modal.getInstance(document.getElementById('addSchoolModal'));
    addSchoolModal.hide();
    
    // Show the admin credentials modal
    setTimeout(() => {
        const adminCredentialsModal = new bootstrap.Modal(document.getElementById('adminCredentialsModal'));
        adminCredentialsModal.show();
    }, 500);
}

function showSubscriptionModal() {
    // Get admin credentials
    const adminData = {
        username: document.getElementById('adminUsername').value,
        password: document.getElementById('adminPassword').value,
        email: document.getElementById('adminEmail').value
    };
    
    // Validate admin credentials
    if (!adminData.username || !adminData.password || !adminData.email) {
        showAlert('Please fill in all admin credential fields', 'danger');
        return;
    }
    
    // Store admin data in session storage
    sessionStorage.setItem('pendingAdminData', JSON.stringify(adminData));
    
    // Hide admin credentials modal
    const adminCredentialsModal = bootstrap.Modal.getInstance(document.getElementBgetElementById('adminCredentialsModal'));
    adminCredentialsModal.hide();
    
    // Show subscription plan modal
    setTimeout(() => {
        const subscriptionPlanModal = new bootstrap.Modal(document.getElementById('subscriptionPlanModal'));
        subscriptionPlanModal.show();
    }, 500);
}

function backToAdminCredentials() {
    // Hide subscription plan modal
    const subscriptionPlanModal = bootstrap.Modal.getInstance(document.getElementById('subscriptionPlanModal'));
    subscriptionPlanModal.hide();
    
    // Show admin credentials modal
    setTimeout(() => {
        const adminCredentialsModal = new bootstrap.Modal(document.getElementById('adminCredentialsModal'));
        adminCredentialsModal.show();
    }, 500);
}

function completeRegistration() {
    if (!isFirebaseConnected) {
        showAlert('Please connect to Firebase first', 'danger');
        return;
    }
    
    // Get school data
    const schoolData = {
        name: document.getElementById('schoolName').value,
        code: document.getElementById('schoolCode').value,
        type: document.getElementById('schoolType').value,
        establishedYear: document.getElementById('establishedYear').value,
        address: {
            complete: document.getElementById('schoolAddress').value,
            city: document.getElementById('city').value,
            state: document.getElementById('state').value,
            zipCode: document.getElementById('zipCode').value
        },
        contacts: {
            principal: {
                name: document.getElementById('principalName').value,
                email: document.getElementById('principalEmail').value
            },
            admin: {
                name: document.getElementById('adminName').value,
                email: document.getElementById('adminEmail').value
            },
            phone: document.getElementById('schoolPhone').value,
            alternatePhone: document.getElementById('alternatePhone').value
        },
        details: {
            capacity: parseInt(document.getElementById('studentCapacity').value),
            currentStudents: parseInt(document.getElementById('currentStudents').value) || 0,
            teacherCount: parseInt(document.getElementById('teacherCount').value) || 0,
            accreditation: document.getElementById('accreditation').value,
            website: document.getElementById('website').value
        },
        facilities: {
            library: document.getElementById('hasLibrary').checked,
            computerLab: document.getElementById('hasLab').checked,
            sports: document.getElementById('hasSports').checked,
            transportation: document.getElementById('hasTransport').checked
        }
    };
    
    // Get admin credentials
    const adminData = {
        username: document.getElementById('adminUsername').value,
        password: document.getElementById('adminPassword').value,
        email: document.getElementById('adminEmail').value
    };
    
    // Get selected subscription plan
    const selectedPlan = document.querySelector('input[name="subscriptionPlan"]:checked').value;
    
    // Calculate plan duration
    const startDate = new Date();
    const endDate = new Date();
    if (selectedPlan === 'spark') {
        endDate.setMonth(endDate.getMonth() + 1); // 1 month for Spark plan
    } else {
        endDate.setMonth(endDate.getMonth() + 2); // 2 months for Bullet plan
    }
    
    // Create complete school data object
    const completeSchoolData = {
        ...schoolData,
        admin: {
            username: adminData.username,
            email: adminData.email
            // Note: We don't store the password in plain text in the school record
        },
        subscription: {
            plan: selectedPlan,
            startDate: startDate.toISOString(),
            endDate: endDate.toISOString(),
            status: 'active'
        },
        status: 'Active',
        registrationDate: new Date().toISOString(),
        lastUpdated: new Date().toISOString(),
        ownerId: currentUser ? currentUser.uid : null
    };
    
    // Save school data to Firebase
    const newSchoolRef = database.ref('schools').push();
    const schoolId = newSchoolRef.key;
    
    // Save school data
    newSchoolRef.set(completeSchoolData)
        .then(() => {
            // Also save admin credentials in a separate secure location
            database.ref('schoolAdmins/' + schoolId).set({
                username: adminData.username,
                email: adminData.email,
                schoolId: schoolId,
                createdAt: new Date().toISOString()
            });
            
            // Also save in owner's database with proper error handling
            if (currentUser) {
                // Make sure to include the schoolId in the data saved to owner's database
                const ownerSchoolData = {
                    ...completeSchoolData,
                    schoolId: schoolId
                };
                
                ownerAuth.database().ref('owners/' + currentUser.uid + '/schools/' + schoolId).set(ownerSchoolData)
                    .then(() => {
                        console.log("School saved in owner's database");
                    })
                    .catch(error => {
                        console.error("Error saving to owner's database:", error);
                        // Try again with a simplified object if the full object fails
                        const simplifiedData = {
                            name: schoolData.name,
                            code: schoolData.code,
                            type: schoolData.type,
                            schoolId: schoolId,
                            status: 'Active',
                            registrationDate: new Date().toISOString()
                        };
                        ownerAuth.database().ref('owners/' + currentUser.uid + '/schools/' + schoolId).set(simplifiedData)
                            .then(() => console.log("Simplified school data saved in owner's database"))
                            .catch(err => console.error("Failed to save even simplified data:", err));
                    });
            }
            
            // Hide subscription plan modal if it exists
            const subscriptionPlanModal = bootstrap.Modal.getInstance(document.getElementById('subscriptionPlanModal'));
            if (subscriptionPlanModal) {
                subscriptionPlanModal.hide();
            }
            
            // Show success message
            showAlert('School registered successfully with admin account and ' + 
                (selectedPlan === 'spark' ? '1 month' : '2 month') + ' subscription plan!', 'success');
            
            // Add to recent activities
            addRecentActivity(`New school registered: ${schoolData.name} with ${selectedPlan} plan`);
            
            // Reset form and go back to step 1
            resetRegistrationForm();
            
            // Update dashboard stats
            if (typeof updateDashboardStats === 'function') {
                updateDashboardStats();
            }
        })
        .catch((error) => {
            console.error('Error registering school:', error);
            showAlert('Error registering school: ' + error.message, 'danger');
        });
}

// Initialize recent activities with proper handling
function initRecentActivities() {
    const recentActivityList = document.getElementById('recentActivityList');
    if (!recentActivityList) return;
    
    // Clear existing content
    recentActivityList.innerHTML = '';
    
    // Handle empty state
    if (recentActivities.length === 0) {
        const emptyItem = document.createElement('li');
        emptyItem.className = 'list-group-item text-center text-muted';
        emptyItem.textContent = 'No recent activities';
        recentActivityList.appendChild(emptyItem);
        return;
    }
    
    // Add activities to the list
    recentActivities.forEach(activity => {
        const listItem = document.createElement('li');
        listItem.className = 'list-group-item';
        listItem.textContent = activity;
        recentActivityList.appendChild(listItem);
    });
}

// Ensure this function properly shows the selected section
function switchSection(sectionId) {
    // Hide all sections
    const allSections = document.querySelectorAll('main section');
    allSections.forEach(section => {
        section.style.display = 'none';
        section.classList.remove('active');
    });

    // Show selected section
    const selectedSection = document.getElementById(sectionId);
    if (selectedSection) {
        selectedSection.style.display = 'block';
        selectedSection.classList.add('active');
    }
    
    // Update nav link active state
    const navLinks = document.querySelectorAll('.nav-link');
    navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${sectionId}`) {
            link.classList.add('active');
        }
    });
}

// Toggle sidebar function
function toggleSidebar() {
    console.log('Toggle sidebar function called');
    const sidebar = document.querySelector('.sidebar');
    const mainContent = document.querySelector('.main-content');
    const mainHeader = document.querySelector('.main-header');
    
    if (sidebar && mainContent) {
        sidebar.classList.toggle('collapsed');
        mainContent.classList.toggle('sidebar-collapsed');
        
        // Also toggle header width
        if (mainHeader) {
            mainHeader.classList.toggle('sidebar-collapsed');
        }
        
        console.log('Sidebar collapsed:', sidebar.classList.contains('collapsed'));
        console.log('Main content sidebar-collapsed:', mainContent.classList.contains('sidebar-collapsed'));
        
        // Force layout recalculation
        setTimeout(function() {
            window.dispatchEvent(new Event('resize'));
        }, 10);
    } else {
        console.error('Sidebar or main content elements not found');
    }
}

// Add event listener to sidebar toggle button when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('sidebarToggleBtn');
    if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
            console.log('Toggle button clicked');
            toggleSidebar();
        });
    }
    
    // Add resize event listener to handle responsive layout
    window.addEventListener('resize', function() {
        const sidebar = document.querySelector('.sidebar');
        const mainContent = document.querySelector('.main-content');
        const mainHeader = document.querySelector('.main-header');
        
        if (window.innerWidth <= 768) {
            sidebar.classList.add('collapsed');
            mainContent.classList.add('sidebar-collapsed');
            
            // Also adjust header
            if (mainHeader) {
                mainHeader.classList.add('sidebar-collapsed');
            }
        }
    });
    
    // Set up settings form submission handlers
    const securitySettingsForm = document.getElementById('securitySettingsForm');
    if (securitySettingsForm) {
        securitySettingsForm.addEventListener('submit', saveSecuritySettings);
    }
    
    const appearanceSettingsForm = document.getElementById('appearanceSettingsForm');
    if (appearanceSettingsForm) {
        appearanceSettingsForm.addEventListener('submit', saveAppearanceSettings);
    }
    
    // Initialize tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});


    </script>
</body>
