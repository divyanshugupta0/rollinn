    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    <script src="firebase-auth-update.js"></script>
    <script src="owner-update.js"></script>
    <script src="completeRegistration.js"></script>
    <script src="register-button-fix.js"></script>
    <script src="register-school.js"></script>
    <script src="init-firebase.js"></script>
    <script src="load-schools.js"></script>
    <script src="view-school.js"></script>
    <script src="edit-school.js"></script>
    <script src="system-maintenance.js"></script>
    <script src="preview-registration.js"></script>
    <script src="preview-fix.js"></script>
    <script src="analytics-data.js"></script>
    <script src="analytics-loader.js"></script>
    <script src="interactive-map.js"></script>
    
    <script>
        // Initialize AOS
        AOS.init({
            duration: 0,
            once: true,
            disable: true
        });
        
        // Owner Authentication System (separate from schools database)
        let currentUser = null;
        let ownerAuth = null;
        let schools = [];
        let recentActivities = [];
        
        // Initialize owner authentication (this would be loaded from a secure source, not in JS)
        function initializeOwnerAuth() {
            // This would normally be loaded from a secure server-side source
            // For demo purposes, we'll use the Firebase config
            return firebase.initializeApp({
                apiKey: "AIzaSyBDSqznTksJ1l0BGTHjwLsCiydp1uT0BNQ",
                authDomain: "firechat-c9145.firebaseapp.com",
                databaseURL: "https://firechat-c9145-default-rtdb.asia-southeast1.firebasedatabase.app",
                projectId: "firechat-c9145",
                storageBucket: "firechat-c9145.firebasestorage.app",
                messagingSenderId: "163533635750",
                appId: "1:163533635750:web:a8c72a63eb583ae04d7467",
                measurementId: "G-9MWC4K4REX"
            }, "ownerAuth");
        }
        
        // Check if user is already logged in
        document.addEventListener('DOMContentLoaded', function() {
            try {
                // Initialize owner authentication system
                ownerAuth = initializeOwnerAuth();
                
                // Check authentication state - directly show app when authenticated
                ownerAuth.auth().onAuthStateChanged((user) => {
                    if (user) {
                        // Store the user and show app
                        currentUser = user;
                        showApp(user);
                    } else {
                        // User is signed out
                        hideApp();
                    }
                });
                
                // Set up login form submission handler
                document.getElementById('loginForm').addEventListener('submit', handleLogin);
                
                // Set up settings form submission handlers
                document.getElementById('generalSettingsForm').addEventListener('submit', saveGeneralSettings);
                document.getElementById('notificationSettingsForm').addEventListener('submit', saveNotificationSettings);
                
                // Set up school registration form submission handler
                document.getElementById('schoolRegistrationForm').addEventListener('submit', handleSchoolRegistration);
                
                // Initialize floating shapes animation for login page
                initLoginAnimations();
                
            } catch (error) {
                console.error("Error initializing owner authentication:", error);
                showAlert("Error initializing authentication system", "danger");
            }
        });
        
        // Initialize login page animations
        function initLoginAnimations() {
            const shapes = document.querySelectorAll('.shape');
            shapes.forEach(shape => {
                const randomX = Math.random() * 20 - 10;
                const randomY = Math.random() * 20 - 10;
                const randomRotate = Math.random() * 10 - 5;
                
                shape.style.transform = `translate(${randomX}px, ${randomY}px) rotate(${randomRotate}deg)`;
            });
        }
        
        // Handle login form submission
        function handleLogin(e) {
            e.preventDefault();
            
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            
            // Show loading state
            const submitBtn = document.querySelector('#loginForm button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Logging in...';
            submitBtn.disabled = true;
            
            // Disable email and password fields
            document.getElementById('email').disabled = true;
            document.getElementById('password').disabled = true;
            
            // First sign out any existing user to prevent automatic login
            ownerAuth.auth().signOut().then(() => {
                // Now authenticate with email and password
                ownerAuth.auth().signInWithEmailAndPassword(email, password)
                    .then((userCredential) => {
                        // User is signed in to owner system
                        const user = userCredential.user;
                        
                        // Check if 2FA is enabled for this user
                        ownerAuth.database().ref('owners/' + user.uid + '/settings/security/twoFactorAuthActive').once('value')
                            .then((snapshot) => {
                                // Reset form state
                                submitBtn.innerHTML = originalBtnText;
                                submitBtn.disabled = false;
                                document.getElementById('email').disabled = false;
                                document.getElementById('password').disabled = false;
                                
                                if (snapshot.exists() && snapshot.val() === true) {
                                    // 2FA is enabled, send OTP and show verification form
                                    sendLoginOTP(user);
                                } else {
                                    // 2FA not enabled, proceed with login
                                    showApp(user);
                                }
                            })
                            .catch((error) => {
                                console.error('Error checking 2FA status:', error);
                                showAlert('Error checking authentication status', 'danger');
                                submitBtn.innerHTML = originalBtnText;
                                submitBtn.disabled = false;
                                document.getElementById('email').disabled = false;
                                document.getElementById('password').disabled = false;
                                // Sign out to prevent automatic login
                                ownerAuth.auth().signOut();
                            });
                    })
                    .catch((error) => {
                        console.error('Login error:', error);
                        showAlert('Login failed: ' + error.message, 'danger');
                        submitBtn.innerHTML = originalBtnText;
                        submitBtn.disabled = false;
                        document.getElementById('email').disabled = false;
                        document.getElementById('password').disabled = false;
                    });
            });
        }
        
        // Send OTP via Web3Forms API and show verification form
        function sendLoginOTP(user) {
            // Generate a random 6-digit OTP
            const otp = Math.floor(100000 + Math.random() * 900000).toString();
            
            // Store OTP in database for verification
            ownerAuth.database().ref('owners/' + user.uid + '/otpVerification').set({
                otp: otp,
                timestamp: Date.now(),
                expires: Date.now() + 600000 // 10 minutes expiry
            }).then(() => {
                console.log("OTP saved to database");
                
                // Send OTP via Web3Forms API
                fetch('https://api.web3forms.com/submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        access_key: '2def5933-b1c7-4028-8655-c2c6b2bf08e2',
                        subject: 'Your Login Verification Code',
                        from_name: 'RollCall Security',
                        to_email: user.email,
                        message: `Your login verification code is: ${otp}. This code will expire in 10 minutes.`
                    })
                });
                
                // Show OTP verification form
                const loginForm = document.getElementById('loginForm');
                loginForm.innerHTML = `
                    <div id="otpVerificationForm" data-uid="${user.uid}" data-email="${user.email}">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            A verification code has been sent to your email: ${user.email}
                        </div>
                        <div class="mb-4">
                            <label for="otpCode" class="form-label">Verification Code</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                <input type="text" class="form-control" id="otpCode" placeholder="Enter 6-digit code" required>
                            </div>
                        </div>
                        <button type="button" class="btn btn-primary w-100 mb-3" onclick="verifyLoginOTP()">
                            <i class="fas fa-shield-alt me-2"></i>Verify & Login
                        </button>
                        <div class="d-flex justify-content-between">
                            <a href="#" onclick="resendOTP('${user.uid}', '${user.email}')">Resend verification code</a>
                            <a href="#" onclick="cancelOTPVerification()">Cancel</a>
                        </div>
                    </div>
                `;
            }).catch(error => {
                console.error("Error saving OTP to database:", error);
                showAlert('Error setting up verification', 'danger');
            });
        }
        
        // Resend OTP
        function resendOTP(uid, email) {
            if (!uid || !email) {
                // Try to get from form if not provided as parameters
                const otpForm = document.getElementById('otpVerificationForm');
                if (otpForm) {
                    uid = otpForm.getAttribute('data-uid');
                    email = otpForm.getAttribute('data-email');
                }
                
                if (!uid || !email) {
                    showAlert('Unable to resend verification code', 'danger');
                    return;
                }
            }
            
            // Generate new OTP
            const otp = Math.floor(100000 + Math.random() * 900000).toString();
            
            // Update OTP in database
            ownerAuth.database().ref('owners/' + uid + '/otpVerification').set({
                otp: otp,
                timestamp: Date.now(),
                expires: Date.now() + 600000 // 10 minutes expiry
            }).then(() => {
                // Send new OTP
                fetch('https://api.web3forms.com/submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        access_key: '2def5933-b1c7-4028-8655-c2c6b2bf08e2',
                        subject: `Your Login Verification Code`,
                        from_name: 'RollCall Security',
                        to_email: email,
                        message: `Your login verification code is: ${otp}. This code will expire in 10 minutes.`
                    })
                });
                
                showAlert('New verification code sent', 'info');
            }).catch(error => {
                console.error("Error resending OTP:", error);
                showAlert('Error sending verification code', 'danger');
            });
        }
        
        // Verify login OTP
        function verifyLoginOTP() {
            const otpCode = document.getElementById('otpCode').value;
            const pendingUser = JSON.parse(sessionStorage.getItem('pendingLoginUser'));
            
            if (!otpCode || otpCode.length !== 6 || !/^\d+$/.test(otpCode)) {
                showAlert('Please enter a valid 6-digit code', 'danger');
                return;
            }
            
            if (!pendingUser) {
                showAlert('Verification session expired', 'danger');
                return;
            }
            
            // Get OTP from database
            ownerAuth.database().ref('owners/' + pendingUser.uid + '/otpVerification').once('value')
                .then(snapshot => {
                    if (snapshot.exists()) {
                        const otpData = snapshot.val();
                        const now = Date.now();
                        
                        // Check if OTP is expired
                        if (now > otpData.expires) {
                            showAlert('Verification code expired', 'danger');
                            return;
                        }
                        
                        // Check if OTP matches
                        if (otpCode === otpData.otp) {
                            // OTP is valid, complete login
                            
                            // Clear OTP data from database
                            ownerAuth.database().ref('owners/' + pendingUser.uid + '/otpVerification').remove();
                            
                            // Clear session storage
                            sessionStorage.removeItem('pendingLoginUser');
                            sessionStorage.removeItem('originalLoginForm');
                            
                            // Complete login
                            showAlert('Verification successful!', 'success');
                            showApp({ uid: pendingUser.uid, email: pendingUser.email });
                        } else {
                            showAlert('Invalid verification code', 'danger');
                        }
                    } else {
                        showAlert('Verification session expired', 'danger');
                    }
                })
                .catch(error => {
                    console.error("Error verifying OTP:", error);
                    showAlert('Error verifying code', 'danger');
                });
        }
        
        // Cancel OTP verification
        function cancelOTPVerification() {
            const loginForm = document.getElementById('loginForm');
            const otpForm = document.getElementById('otpVerificationForm');
            
            // Get user ID from form if available
            let userUid = null;
            if (otpForm) {
                userUid = otpForm.getAttribute('data-uid');
            }
            
            // Reset login form
            loginForm.innerHTML = `
                <div class="mb-4">
                    <label for="email" class="form-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" class="form-control" id="email" placeholder="Enter your email" required>
                    </div>
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" class="form-control" id="password" placeholder="Enter your password" required>
                    </div>
                </div>
                <div class="mb-4 form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">Remember me</label>
                    <a href="#" class="float-end text-decoration-none">Forgot password?</a>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-sign-in-alt me-2"></i>Login
                </button>
            `;
            
            // Clear OTP data from database if we have a user ID
            if (userUid) {
                ownerAuth.database().ref('owners/' + userUid + '/otpVerification').remove();
            }
            
            // Sign out
            ownerAuth.auth().signOut();
        }
        
        // Show OTP verification for login
        function showLoginOTPVerification(user) {
            // Generate a random 6-digit OTP
            const otp = Math.floor(100000 + Math.random() * 900000).toString();
            
            // Store OTP in session storage for verification
            sessionStorage.setItem('loginOTP', otp);
            sessionStorage.setItem('pendingLoginUser', JSON.stringify({
                uid: user.uid,
                email: user.email
            }));
            
            // Send OTP via Web3Forms API
            fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    access_key: '5f0dff5e-d4d9-4498-a5f0-7a5b5f5e5d4d', // Replace with your Web3Forms API key
                    subject: 'Your Login Verification Code',
                    from_name: 'RollCall Security',
                    to_email: user.email,
                    message: `Your login verification code is: ${otp}. This code will expire in 10 minutes.`
                })
            });
            
            // Create OTP input form
            const loginForm = document.getElementById('loginForm');
            const loginFormHTML = loginForm.innerHTML;
            
            // Store original form HTML for later restoration
            sessionStorage.setItem('originalLoginForm', loginFormHTML);
            
            // Replace login form with OTP form
            loginForm.innerHTML = `
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    A verification code has been sent to your email: ${user.email}
                </div>
                <div class="mb-4">
                    <label for="otpCode" class="form-label">Verification Code</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-key"></i></span>
                        <input type="text" class="form-control" id="otpCode" placeholder="Enter 6-digit code" required>
                    </div>
                </div>
                <button type="button" class="btn btn-primary w-100" onclick="verifyLoginOTP()">
                    <i class="fas fa-shield-alt me-2"></i>Verify & Login
                </button>
                <div class="text-center mt-3">
                    <a href="#" onclick="cancelOTPVerification()">Cancel and try again</a>
                </div>
            `;
        }
        
        // Verify login OTP
        function verifyLoginOTP() {
            const otpCode = document.getElementById('otpCode').value;
            const pendingUser = JSON.parse(sessionStorage.getItem('pendingLoginUser'));
            
            if (!otpCode || otpCode.length !== 6 || !/^\d+$/.test(otpCode)) {
                showAlert('Please enter a valid 6-digit code', 'danger');
                return;
            }
            
            if (!pendingUser) {
                showAlert('Verification session expired', 'danger');
                return;
            }
            
            // Get OTP from database
            ownerAuth.database().ref('owners/' + pendingUser.uid + '/otpVerification').once('value')
                .then(snapshot => {
                    if (snapshot.exists()) {
                        const otpData = snapshot.val();
                        const now = Date.now();
                        
                        // Check if OTP is expired
                        if (now > otpData.expires) {
                            showAlert('Verification code expired', 'danger');
                            return;
                        }
                        
                        // Check if OTP matches
                        if (otpCode === otpData.otp) {
                            // OTP is valid, complete login
                            
                            // Clear OTP data from database
                            ownerAuth.database().ref('owners/' + pendingUser.uid + '/otpVerification').remove();
                            
                            // Clear session storage
                            sessionStorage.removeItem('pendingLoginUser');
                            sessionStorage.removeItem('originalLoginForm');
                            
                            // Complete login
                            showAlert('Verification successful!', 'success');
                            showApp({ uid: pendingUser.uid, email: pendingUser.email });
                        } else {
                            showAlert('Invalid verification code', 'danger');
                        }
                    } else {
                        showAlert('Verification session expired', 'danger');
                    }
                })
                .catch(error => {
                    console.error("Error verifying OTP:", error);
                    showAlert('Error verifying code', 'danger');
                });
        }
        
        // Cancel OTP verification and restore login form
        function cancelOTPVerification() {
            const loginForm = document.getElementById('loginForm');
            const originalForm = sessionStorage.getItem('originalLoginForm');
            
            if (originalForm) {
                loginForm.innerHTML = originalForm;
                
                // Clear OTP data
                sessionStorage.removeItem('loginOTP');
                sessionStorage.removeItem('pendingLoginUser');
                sessionStorage.removeItem('originalLoginForm');
                
                // Sign out the pending user
                ownerAuth.auth().signOut();
            }
        }
        
        // This duplicate code is removed
        
        // Show app content and hide login
        function showApp(user) {
            document.getElementById('loginContainer').style.display = 'none';
            document.getElementById('appContent').style.display = 'block';
            
            // Update user name in header
            document.getElementById('loggedInUserName').textContent = user.email;
            
            // Set current user for global access
            currentUser = user;
            
            // Initialize Firebase for schools database
            initializeFirebase();
            
            // Try to get user's display name and settings from owner database
            ownerAuth.database().ref('owners/' + user.uid).once('value')
                .then((snapshot) => {
                    if (snapshot.exists()) {
                        const userData = snapshot.val();
                        
                        // Update user name if available
                        if (userData.name) {
                            document.getElementById('loggedInUserName').textContent = userData.name;
                        }
                        
                        // Load general settings if available
                        if (userData.settings && userData.settings.general) {
                            const generalSettings = userData.settings.general;
                            if (document.getElementById('systemName')) {
                                document.getElementById('systemName').value = generalSettings.systemName || 'RollCall';
                            }
                            if (document.getElementById('adminEmail')) {
                                document.getElementById('adminEmail').value = generalSettings.adminEmail || user.email;
                            }
                            if (document.getElementById('timezone')) {
                                document.getElementById('timezone').value = generalSettings.timezone || 'UTC';
                            }
                            if (document.getElementById('dateFormat')) {
                                document.getElementById('dateFormat').value = generalSettings.dateFormat || 'MM/DD/YYYY';
                            }
                        }
                        
                        // Load notification settings if available
                        if (userData.settings && userData.settings.notifications) {
                            const notifSettings = userData.settings.notifications;
                            if (document.getElementById('emailNotifications')) {
                                document.getElementById('emailNotifications').checked = notifSettings.emailNotifications !== false;
                            }
                            if (document.getElementById('smsNotifications')) {
                                document.getElementById('smsNotifications').checked = notifSettings.smsNotifications === true;
                            }
                            if (document.getElementById('pushNotifications')) {
                                document.getElementById('pushNotifications').checked = notifSettings.pushNotifications !== false;
                            }
                            if (document.getElementById('emailFrequency')) {
                                document.getElementById('emailFrequency').value = notifSettings.emailFrequency || 'instant';
                            }
                            
                            // Load notification events
                            if (notifSettings.notifyEvents) {
                                if (document.getElementById('notifyNewSchool')) {
                                    document.getElementById('notifyNewSchool').checked = notifSettings.notifyEvents.newSchool !== false;
                                }
                                if (document.getElementById('notifySubscription')) {
                                    document.getElementById('notifySubscription').checked = notifSettings.notifyEvents.subscription !== false;
                                }
                                if (document.getElementById('notifySystem')) {
                                    document.getElementById('notifySystem').checked = notifSettings.notifyEvents.system !== false;
                                }
                            }
                        }
                        
                        // Load security settings if available
                        if (userData.settings && userData.settings.security) {
                            const securitySettings = userData.settings.security;
                            
                            if (document.getElementById('passwordPolicy')) {
                                document.getElementById('passwordPolicy').value = securitySettings.passwordPolicy || 'standard';
                            }
                            if (document.getElementById('sessionTimeout')) {
                                document.getElementById('sessionTimeout').value = securitySettings.sessionTimeout || 30;
                            }
                            if (document.getElementById('twoFactorAuth')) {
                                document.getElementById('twoFactorAuth').checked = securitySettings.twoFactorAuth === true;
                            }
                            if (document.getElementById('twoFactorAuthActive')) {
                                document.getElementById('twoFactorAuthActive').checked = securitySettings.twoFactorAuthActive === true;
                            }
                            if (document.getElementById('loginNotifications')) {
                                document.getElementById('loginNotifications').checked = securitySettings.loginNotifications !== false;
                            }
                        }
                        
                        // Load appearance settings if available
                        if (userData.settings && userData.settings.appearance) {
                            const appearanceSettings = userData.settings.appearance;
                            
                            if (document.getElementById('themeColor')) {
                                document.getElementById('themeColor').value = appearanceSettings.themeColor || 'default';
                            }
                            if (document.getElementById('dashboardLayout')) {
                                document.getElementById('dashboardLayout').value = appearanceSettings.dashboardLayout || 'standard';
                            }
                            if (document.getElementById('fontFamily')) {
                                document.getElementById('fontFamily').value = appearanceSettings.fontFamily || 'inter';
                            }
                            if (document.getElementById('animationsEnabled')) {
                                document.getElementById('animationsEnabled').checked = appearanceSettings.animationsEnabled !== false;
                            }
                            
                            // Apply appearance settings
                            applyAppearanceSettings(appearanceSettings);
                        }
                        
                        // Load recent activities if available
                        if (userData.recentActivities) {
                            recentActivities = Object.values(userData.recentActivities)
                                .sort((a, b) => b.timestamp - a.timestamp)
                                .map(item => item.message)
                                .slice(0, 10);
                            
                            // Initialize recent activities list
                            initRecentActivities();
                        }
                    }
                })
                .catch(error => {
                    console.error("Error loading user data:", error);
                });
                
            // Load Firebase configuration for schools if available
            loadFirebaseConfig();
        }
        
        // Hide app content and show login
        function hideApp() {
            document.getElementById('loginContainer').style.display = 'flex';
            document.getElementById('appContent').style.display = 'none';
            
            // Reset form and clear any previous alerts
            document.getElementById('loginForm').reset();
            document.getElementById('loginAlert').style.display = 'none';
            
            // Remove any floating alerts
            document.querySelectorAll('.floating-alert').forEach(el => el.remove());
        }
        
        // User dropdown toggle
        document.getElementById('userDropdownToggle').addEventListener('click', () => {
            document.getElementById('userDropdownMenu').classList.toggle('show');
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.user-dropdown')) {
                document.getElementById('userDropdownMenu').classList.remove('show');
            }
        });
        
        // Reset password
        document.getElementById('resetPasswordBtn').addEventListener('click', (e) => {
            e.preventDefault();
            
            if (!currentUser) return;
            
            const email = currentUser.email;
            
            ownerAuth.auth().sendPasswordResetEmail(email)
                .then(() => {
                    showAlert('Password reset email sent to ' + email, 'success');
                })
                .catch((error) => {
                    showAlert('Error sending password reset email: ' + error.message, 'danger');
                });
        });
        
        // Logout
        document.getElementById('logoutBtn').addEventListener('click', (e) => {
            e.preventDefault();
            
            ownerAuth.auth().signOut()
                .then(() => {
                    hideApp();
                    showAlert('You have been logged out', 'info');
                })
                .catch((error) => {
                    showAlert('Error logging out: ' + error.message, 'danger');
                });
        });
        
        // Show alert message
        function showAlert(message, type) {
            // Determine which alert element to use based on current view
            let alertElement;
            if (document.getElementById('loginContainer').style.display !== 'none') {
                alertElement = document.getElementById('loginAlert');
                // Set alert content if it's the login alert
                alertElement.className = `alert alert-${type}`;
                alertElement.innerHTML = message;
                alertElement.style.display = 'block';
                
                // Hide login alert after 5 seconds
                setTimeout(() => {
                    alertElement.style.display = 'none';
                }, 5000);
            } else {
                // Create a floating alert for the main app view that appears from top
                alertElement = document.createElement('div');
                alertElement.className = `alert alert-${type} alert-dismissible fade show notification-toast`;
                alertElement.style.position = 'fixed';
                alertElement.style.top = '-100px';
                alertElement.style.left = '50%';
                alertElement.style.transform = 'translateX(-50%)';
                alertElement.style.zIndex = '9999';
                alertElement.style.minWidth = '300px';
                alertElement.style.textAlign = 'center';
                alertElement.style.borderRadius = '8px';
                alertElement.style.boxShadow = '0 5px 15px rgba(0,0,0,0.2)';
                alertElement.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                document.body.appendChild(alertElement);
                
                // Animate in
                setTimeout(() => {
                    alertElement.style.top = '20px';
                    alertElement.style.transition = 'top 0.3s ease-out, opacity 0.3s ease-out';
                    alertElement.style.opacity = '1';
                }, 10);
                
                // Hide floating alert after 5 seconds
                setTimeout(() => {
                    alertElement.style.top = '-100px';
                    alertElement.style.opacity = '0';
                    setTimeout(() => {
                        alertElement.remove();
                    }, 300); // Remove after hide animation completes
                }, 5000);
            }
        }
        
        // Add notification toast styles - ensure they're added to head
        document.addEventListener('DOMContentLoaded', function() {
            // Remove any existing toast styles
            const existingStyle = document.getElementById('notification-toast-styles');
            if (existingStyle) {
                existingStyle.remove();
            }
            
            // Add new toast styles
            const toastStyles = document.createElement('style');
            toastStyles.id = 'notification-toast-styles';
            toastStyles.textContent = `
                .notification-toast {
                    position: fixed !important;
                    top: -100px !important;
                    left: 50% !important;
                    transform: translateX(-50%) !important;
                    z-index: 9999 !important;
                    min-width: 300px !important;
                    box-shadow: 0 5px 15px rgba(0,0,0,0.2) !important;
                    animation: toastSlideIn 0.3s ease-out forwards !important;
                    text-align: center !important;
                    border-radius: 8px !important;
                    bottom: auto !important;
                }
                
                .notification-toast-hide {
                    animation: toastSlideOut 0.3s ease-in forwards !important;
                }
                
                @keyframes toastSlideIn {
                    from { top: -100px; opacity: 0; }
                    to { top: 20px; opacity: 1; }
                }
                
                @keyframes toastSlideOut {
                    from { top: 20px; opacity: 1; }
                    to { top: -100px; opacity: 0; }
                }
            `;
            document.head.appendChild(toastStyles);
        });
        
        // Apply toast styles immediately as well
        const immediateToastStyles = document.createElement('style');
        immediateToastStyles.id = 'notification-toast-styles-immediate';
        immediateToastStyles.textContent = `
            .notification-toast {
                position: fixed !important;
                top: -100px !important;
                left: 50% !important;
                transform: translateX(-50%) !important;
                z-index: 9999 !important;
                min-width: 300px !important;
                box-shadow: 0 5px 15px rgba(0,0,0,0.2) !important;
                animation: toastSlideIn 0.3s ease-out forwards !important;
                text-align: center !important;
                border-radius: 8px !important;
                bottom: auto !important;
            }
            
            .notification-toast-hide {
                animation: toastSlideOut 0.3s ease-in forwards !important;
            }
            
            @keyframes toastSlideIn {
                from { top: -100px; opacity: 0; }
                to { top: 20px; opacity: 1; }
            }
            
            @keyframes toastSlideOut {
                from { top: 20px; opacity: 1; }
                to { top: -100px; opacity: 0; }
            }
        `;
        document.head.appendChild(immediateToastStyles);
        
        // Add floating alert and login animation styles
        const styleElement = document.createElement('style');
        styleElement.textContent = `
            .floating-alert {
                position: fixed;
                top: -100px;
                left: 50%;
                transform: translateX(-50%);
                z-index: 9999;
                min-width: 300px;
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
                animation: slideInDown 0.3s ease-out forwards;
                text-align: center;
            }
            
            .floating-alert-hide {
                animation: slideOutUp 0.3s ease-in forwards;
            }
            
            @keyframes slideInDown {
                from { top: -100px; opacity: 0; }
                to { top: 20px; opacity: 1; }
            }
            
            @keyframes slideOutUp {
                from { top: 20px; opacity: 1; }
                to { top: -100px; opacity: 0; }
            }
            
            /* Login page animations */
            .shape {
                animation: floatAnimation 8s infinite ease-in-out;
            }
            
            .shape-1 { animation-delay: 0s; }
            .shape-2 { animation-delay: 1s; }
            .shape-3 { animation-delay: 2s; }
            .shape-4 { animation-delay: 3s; }
            
            @keyframes floatAnimation {
                0%, 100% { transform: translateY(0) rotate(0deg); }
                25% { transform: translateY(-20px) rotate(5deg); }
                50% { transform: translateY(10px) rotate(-5deg); }
                75% { transform: translateY(-15px) rotate(3deg); }
            }
            
            .login-illustration img {
                animation: pulse 4s infinite ease-in-out;
            }
            
            @keyframes pulse {
                0%, 100% { transform: scale(1); }
                50% { transform: scale(1.05); }
            }
        `;
        document.head.appendChild(styleElement);

        let firebaseApp = null;
    let database = null;
    let isFirebaseConnected = false;
    
    // Fix sidebar toggle function
    function toggleSidebar() {
        const sidebar = document.querySelector('.sidebar');
        const mainContent = document.querySelector('.main-content');
        
        if (window.innerWidth <= 768) {
            sidebar.classList.toggle('show');
        } else {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('sidebar-collapsed');
        }
    }
    
    // Initialize Firebase for schools database
    function initializeFirebase() {
        const apiKey = document.getElementById('firebaseApiKey').value;
        const authDomain = document.getElementById('firebaseAuthDomain').value;
        const databaseURL = document.getElementById('firebaseDatabaseURL').value;
        const projectId = document.getElementById('firebaseProjectId').value;
        
        if (!apiKey || !authDomain || !databaseURL || !projectId) {
            showAlert('Please fill in all Firebase configuration fields', 'danger');
            return;
        }
        
        try {
            const firebaseConfig = {
                apiKey: apiKey,
                authDomain: authDomain,
                databaseURL: databaseURL,
                projectId: projectId
            };
            
            // Initialize a separate Firebase instance for schools
            if (firebaseApp) {
                // If already initialized, delete the old instance
                firebaseApp.delete().then(() => {
                    console.log("Previous Firebase app deleted");
                }).catch(error => {
                    console.error("Error deleting previous Firebase app:", error);
                });
            }
            
            firebaseApp = firebase.initializeApp(firebaseConfig, "schoolsApp");
            database = firebaseApp.database();
            isFirebaseConnected = true;
            
            document.getElementById('firebaseStatus').innerHTML = 
                '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Connected</span>';
            
            showAlert('School Firebase connected successfully!', 'success');
            
            // Save this configuration to owner's database for future use
            saveFirebaseConfig(firebaseConfig);
            
            // Load existing schools from Firebase
            loadSchoolsFromFirebase();
            
        } catch (error) {
            console.error('Firebase initialization error:', error);
            showAlert('Failed to connect to Firebase: ' + error.message, 'danger');
            document.getElementById('firebaseStatus').innerHTML = 
                '<span class="badge bg-danger"><i class="fas fa-times me-1"></i>Connection Failed</span>';
        }
    }
    
    // Save Firebase configuration to owner's database
    function saveFirebaseConfig(config) {
        if (!currentUser) return;
        
        // Save the configuration to the owner's database
        ownerAuth.database().ref('owners/' + currentUser.uid + '/schoolsFirebaseConfig').set({
            apiKey: config.apiKey,
            authDomain: config.authDomain,
            databaseURL: config.databaseURL,
            projectId: config.projectId,
            timestamp: Date.now()
        }).then(() => {
            console.log("Firebase configuration saved to owner's database");
        }).catch(error => {
            console.error("Error saving Firebase configuration:", error);
        });
    }
    
    // Save general settings to owner's database
    function saveGeneralSettings(e) {
        e.preventDefault();
        
        if (!currentUser) return;
        
        const settings = {
            systemName: document.getElementById('systemName').value,
            adminEmail: document.getElementById('adminEmail').value,
            timezone: document.getElementById('timezone').value,
            dateFormat: document.getElementById('dateFormat').value,
            updatedAt: Date.now()
        };
        
        ownerAuth.database().ref('owners/' + currentUser.uid + '/settings/general').set(settings)
            .then(() => {
                showAlert('General settings saved successfully', 'success');
                addRecentActivity('General settings updated');
            })
            .catch(error => {
                console.error('Error saving general settings:', error);
                showAlert('Error saving settings: ' + error.message, 'danger');
            });
    }
    
    // Save notification settings to owner's database
    function saveNotificationSettings(e) {
        e.preventDefault();
        
        if (!currentUser) return;
        
        const settings = {
            emailNotifications: document.getElementById('emailNotifications').checked,
            emailFrequency: document.getElementById('emailFrequency').value,
            pushNotifications: document.getElementById('pushNotifications').checked,
            notifyEvents: {
                newSchool: document.getElementById('notifyNewSchool').checked,
                subscription: document.getElementById('notifySubscription').checked,
                system: document.getElementById('notifySystem').checked
            },
            updatedAt: Date.now()
        };
        
        ownerAuth.database().ref('owners/' + currentUser.uid + '/settings/notifications').set(settings)
            .then(() => {
                showAlert('Notification settings saved successfully', 'success');
                addRecentActivity('Notification preferences updated');
            })
            .catch(error => {
                console.error('Error saving notification settings:', error);
                showAlert('Error saving settings: ' + error.message, 'danger');
            });
    }
    
    // Save security settings to owner's database
    function saveSecuritySettings(e) {
        e.preventDefault();
        
        if (!currentUser) return;
        
        // Get current security settings first to preserve twoFactorAuthActive if it exists
        ownerAuth.database().ref('owners/' + currentUser.uid + '/settings/security').once('value')
            .then((snapshot) => {
                const currentSettings = snapshot.exists() ? snapshot.val() : {};
                
                const twoFactorEnabled = document.getElementById('twoFactorAuth').checked;
                const twoFactorActive = document.getElementById('twoFactorAuthActive').checked;
                
                const settings = {
                    passwordPolicy: document.getElementById('passwordPolicy').value,
                    sessionTimeout: document.getElementById('sessionTimeout').value,
                    twoFactorAuth: twoFactorEnabled,
                    twoFactorAuthActive: twoFactorActive,
                    loginNotifications: document.getElementById('loginNotifications').checked,
                    updatedAt: Date.now()
                };
                
                // If 2FA is being disabled, set twoFactorAuthActive to false
                if (!twoFactorEnabled) {
                    settings.twoFactorAuthActive = false;
                }
                
                // If enabling 2FA and activating it for the first time, show setup modal
                const showSetup = twoFactorEnabled && twoFactorActive && !currentSettings.twoFactorAuthActive;
                
                return ownerAuth.database().ref('owners/' + currentUser.uid + '/settings/security').set(settings)
                    .then(() => {
                        showAlert('Security settings saved successfully', 'success');
                        addRecentActivity('Security settings updated');
                        
                        // If two-factor auth was enabled for the first time, show setup instructions
                        if (showSetup) {
                            showTwoFactorSetupModal();
                        } else if (!twoFactorActive && currentSettings.twoFactorAuthActive) {
                            showAlert('Two-factor authentication has been disabled', 'info');
                        }
                    });
            })
            .catch(error => {
                console.error('Error saving security settings:', error);
                showAlert('Error saving settings: ' + error.message, 'danger');
            });
    }
    
    // Save appearance settings to owner's database
    function saveAppearanceSettings(e) {
        e.preventDefault();
        
        if (!currentUser) return;
        
        const settings = {
            themeColor: document.getElementById('themeColor').value,
            dashboardLayout: document.getElementById('dashboardLayout').value,
            fontFamily: document.getElementById('fontFamily').value,
            animationsEnabled: document.getElementById('animationsEnabled').checked,
            updatedAt: Date.now()
        };
        
        ownerAuth.database().ref('owners/' + currentUser.uid + '/settings/appearance').set(settings)
            .then(() => {
                showAlert('Appearance settings saved successfully', 'success');
                addRecentActivity('UI appearance customized');
                applyAppearanceSettings(settings);
            })
            .catch(error => {
                console.error('Error saving appearance settings:', error);
                showAlert('Error saving settings: ' + error.message, 'danger');
            });
    }
    
    // Apply appearance settings to the UI
    function applyAppearanceSettings(settings) {
        // Apply theme color
        let primaryColor, secondaryColor, accentColor;
        
        switch(settings.themeColor) {
            case 'blue':
                primaryColor = '#4a69bd';
                secondaryColor = '#1e3799';
                accentColor = '#00a8ff';
                break;
            case 'green':
                primaryColor = '#6ab04c';
                secondaryColor = '#4a752c';
                accentColor = '#badc58';
                break;
            case 'red':
                primaryColor = '#eb4d4b';
                secondaryColor = '#b71540';
                accentColor = '#ff7979';
                break;
            case 'dark':
                primaryColor = '#2f3640';
                secondaryColor = '#1e272e';
                accentColor = '#487eb0';
                document.body.classList.add('dark-mode');
                break;
            default:
                // Default purple theme
                primaryColor = '#667eea';
                secondaryColor = '#764ba2';
                accentColor = '#f093fb';
                document.body.classList.remove('dark-mode');
        }
        
        // Apply CSS variables
        document.documentElement.style.setProperty('--primary-color', primaryColor);
        document.documentElement.style.setProperty('--secondary-color', secondaryColor);
        document.documentElement.style.setProperty('--accent-color', accentColor);
        
        // Apply font family
        let fontFamily;
        switch(settings.fontFamily) {
            case 'poppins':
                fontFamily = "'Poppins', sans-serif";
                break;
            case 'roboto':
                fontFamily = "'Roboto', sans-serif";
                break;
            case 'opensans':
                fontFamily = "'Open Sans', sans-serif";
                break;
            default:
                fontFamily = "'Inter', sans-serif";
        }
        document.body.style.fontFamily = fontFamily;
        
        // Apply animations setting
        if (!settings.animationsEnabled) {
            const styleElement = document.createElement('style');
            styleElement.id = 'disable-animations';
            styleElement.textContent = '* { animation: none !important; transition: none !important; }';
            document.head.appendChild(styleElement);
        } else {
            const disableStyle = document.getElementById('disable-animations');
            if (disableStyle) {
                disableStyle.remove();
            }
        }
        
        // Apply dashboard layout
        const mainContent = document.querySelector('.main-content');
        if (mainContent) {
            mainContent.classList.remove('layout-standard', 'layout-compact', 'layout-expanded');
            mainContent.classList.add('layout-' + settings.dashboardLayout);
        }
    }
    
    // Show two-factor authentication setup modal
    function showTwoFactorSetupModal() {
        // Generate a random 6-digit OTP
        const otp = Math.floor(100000 + Math.random() * 900000).toString();
        
        // Store OTP in database for verification
        ownerAuth.database().ref('owners/' + currentUser.uid + '/otpVerification').set({
            otp: otp,
            timestamp: Date.now(),
            expires: Date.now() + 600000 // 10 minutes expiry
        });
        
        // Send OTP via Web3Forms API
        const userEmail = document.getElementById('adminEmail').value || currentUser.email;
        
        fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                access_key: '2def5933-b1c7-4028-8655-c2c6b2bf08e2', // Replace with your Web3Forms API key
                subject: 'Your Two-Factor Authentication Code',
                from_name: 'RollCall Security',
                to_email: userEmail,
                message: `Your verification code is: ${otp}. This code will expire in 10 minutes.`
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                console.log('OTP email sent successfully');
            } else {
                console.error('Failed to send OTP email:', data.message);
            }
        })
        .catch(error => {
            console.error('Error sending OTP email:', error);
        });
        
        // Create modal HTML
        const modalHTML = `
            <div class="modal fade" id="twoFactorSetupModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Two-Factor Authentication Setup</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                A verification code has been sent to your email: ${userEmail}
                            </div>
                            <div class="mb-3">
                                <label for="verificationCode" class="form-label">Verification Code</label>
                                <input type="text" class="form-control" id="verificationCode" placeholder="Enter 6-digit code">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" onclick="verifyTwoFactorCode()">Verify & Enable</button>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        // Remove existing modal if any
        const existingModal = document.getElementById('twoFactorSetupModal');
        if (existingModal) {
            existingModal.remove();
        }
        
        // Create and show new modal
        const modalElement = document.createElement('div');
        modalElement.innerHTML = modalHTML;
        document.body.appendChild(modalElement);
        const modal = new bootstrap.Modal(document.getElementById('twoFactorSetupModal'));
        modal.show();
    }
    
    // Verify two-factor authentication code
    function verifyTwoFactorCode() {
        const code = document.getElementById('verificationCode').value;
        
        if (!code || code.length !== 6 || !/^\d+$/.test(code)) {
            showAlert('Please enter a valid 6-digit verification code', 'danger');
            return;
        }
        
        // Get OTP from database
        ownerAuth.database().ref('owners/' + currentUser.uid + '/otpVerification').once('value')
            .then(snapshot => {
                if (snapshot.exists()) {
                    const otpData = snapshot.val();
                    const now = Date.now();
                    
                    // Check if OTP is expired
                    if (now > otpData.expires) {
                        showAlert('Verification code expired', 'danger');
                        return;
                    }
                    
                    // Direct string comparison of entered code with stored OTP
                    if (code === otpData.otp) {
                        showAlert('Two-factor authentication enabled successfully!', 'success');
                        
                        // Clear the OTP from database
                        ownerAuth.database().ref('owners/' + currentUser.uid + '/otpVerification').remove();
                        
                        // Close the modal
                        const modal = bootstrap.Modal.getInstance(document.getElementById('twoFactorSetupModal'));
                        if (modal) {
                            modal.hide();
                        }
                        
                        // Update the database to confirm 2FA is active
                        if (currentUser) {
                            ownerAuth.database().ref('owners/' + currentUser.uid + '/settings/security/twoFactorAuthActive').set(true);
                        }
                    } else {
                        showAlert('Invalid verification code. Please try again.', 'danger');
                    }
                } else {
                    showAlert('Verification session expired', 'danger');
                }
            })
            .catch(error => {
                console.error("Error verifying OTP:", error);
                showAlert('Error verifying code', 'danger');
            });
    }
    
    // System maintenance functions
    function backupDatabase() {
        if (!currentUser) return;
        
        showAlert('Database backup started...', 'info');
        
        // Record backup action in owner's database
        ownerAuth.database().ref('owners/' + currentUser.uid + '/maintenance/backups').push({
            timestamp: Date.now(),
            status: 'completed',
            type: 'manual'
        }).then(() => {
            showAlert('Database backup completed successfully', 'success');
        }).catch(error => {
            console.error('Error recording backup:', error);
            showAlert('Error during backup: ' + error.message, 'danger');
        });
    }
    
    function clearCache() {
        showAlert('Cache clearing in progress...', 'info');
        
        // Record cache clear action in owner's database
        if (currentUser) {
            ownerAuth.database().ref('owners/' + currentUser.uid + '/maintenance/cacheClears').push({
                timestamp: Date.now(),
                status: 'completed'
            });
        }
        
        setTimeout(() => {
            showAlert('Cache cleared successfully', 'success');
        }, 1500);
    }
    
    function updateSystem() {
        showAlert('System update in progress...', 'info');
        
        // Record system update action in owner's database
        if (currentUser) {
            ownerAuth.database().ref('owners/' + currentUser.uid + '/maintenance/updates').push({
                timestamp: Date.now(),
                status: 'completed',
                version: '1.0.1'
            });
        }
        
        setTimeout(() => {
            showAlert('System updated successfully to version 1.0.1', 'success');
        }, 2000);
    }
    
    function restartSystem() {
        if (confirm('Are you sure you want to restart the system? This will log you out.')) {
            showAlert('System restarting...', 'warning');
            
            // Record system restart action in owner's database
            if (currentUser) {
                ownerAuth.database().ref('owners/' + currentUser.uid + '/maintenance/restarts').push({
                    timestamp: Date.now(),
                    status: 'initiated'
                });
            }
            
            setTimeout(() => {
                // Log out the user to simulate restart
                ownerAuth.auth().signOut()
                    .then(() => {
                        hideApp();
                        showAlert('System restarted successfully. Please log in again.', 'success');
                    })
                    .catch(error => {
                        showAlert('Error during restart: ' + error.message, 'danger');
                    });
            }, 3000);
        }
    }
    
